# PostgreSQL (Neon, Supabase, Railway, ou instance locale)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Back-office /admin : mot de passe de connexion et secret pour signer le JWT (voir README)
ADMIN_PASSWORD="changez-moi"
ADMIN_JWT_SECRET="générez-une-chaîne-longue-et-aléatoire"

# Optionnel : URL publique du site (SEO, liens absolus si tu l’utilises ailleurs)
# NEXT_PUBLIC_SITE_URL=https://votre-site.netlify.app
