# Neon / Postgres simple : dupliquer la même URL dans les deux variables.
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."

# ─── Supabase (exemple : deux URIs différentes) ─────────────────────────────
# Sur Vercel / runtime : DATABASE_URL = Transaction pooler (6543, ?pgbouncer=true)
# Migrations locales : DIRECT_URL = connexion Direct (db.<ref>.supabase.co:5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-....pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Back-office /admin
ADMIN_PASSWORD="changez-moi"
ADMIN_JWT_SECRET="générez-une-chaîne-longue-et-aléatoire"

# Facultatif mais recommandé : URL canonique (www = domaine principal)
NEXT_PUBLIC_SITE_URL=https://www.climsystem-distribution-atlantique.fr
