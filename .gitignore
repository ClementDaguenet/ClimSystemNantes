# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# vercel (ancien)
.vercel

# netlify CLI local
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Fichiers téléversés via l’admin (le dossier existe grâce à .gitkeep)
/public/uploads/**
!/public/uploads/.gitkeep
