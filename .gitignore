# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# rendus workshop (local - hors repo)
/rendu/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# vercel CLI (projets linkés localement avec `vercel link`)
.vercel

# dossier métadonnées Netlify CLI (si utilisé encore en local - optionnel à supprimer)

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Fichiers ignorés Git (anciens téléversements test ; éviter commits accidentels).
/public/uploads/**
!/public/uploads/.gitkeep

# Dump CMS prod (data-URL / contenus édités) — ne pas versionner
/tmp/